{
  "name": "dsh-grok-workflow",
  "version": "0.1.0",
  "description": "Bounded plan-execute-verify-retry-synthesize workflows for DeepSeek Harness",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "workflow",
    "multi-agent",
    "verification"
  ],
  "engines": {
    "dsh": "0.2.1-rc.2",
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src test",
    "test": "npm run build && vitest run",
    "test:unit": "vitest run test/orchestrator.spec.ts test/redact.spec.ts test/input.spec.ts test/criterion.spec.ts test/report.spec.ts test/plugin-lifecycle.spec.ts",
    "test:loader": "npm run build && vitest run test/loader.spec.ts",
    "ci": "npm run typecheck && npm run lint && npm test"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-workflow": "0.2.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/cordis-plugin-include": "1.0.10",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-ptc-runtime": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.2.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-workflow": "0.2.1-rc.2",
    "@deepseek-ai/dsh-workflow-ptc": "0.2.1-rc.2",
    "@types/node": "^22.20.1",
    "js-yaml": "^4.1.0",
    "oxlint": "1.81.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/free6589/dsh-grok-workflow.git"
  },
  "homepage": "https://github.com/free6589/dsh-grok-workflow#readme",
  "bugs": {
    "url": "https://github.com/free6589/dsh-grok-workflow/issues"
  }
}
